# 工作区目录
DESIGNDRAFT_WORKSPACE_DIR=.workspace

# AI Agent 配置
DESIGNDRAFT_AGENT_PROVIDER=deepseek
# 代码生成模型（快速/便宜）
DESIGNDRAFT_AGENT_MODEL=deepseek-v4-flash
# 推理分析模型（更强/更贵，用于需求分析等）
DESIGNDRAFT_AGENT_REASONING_MODEL=deepseek-v4-pro
DESIGNDRAFT_AGENT_BASE_URL=https://api.deepseek.com
DESIGNDRAFT_AGENT_API_KEY=sk-xxx

# 部署认证（留空则不启用认证）
DESIGNDRAFT_AUTH_TOKEN=
